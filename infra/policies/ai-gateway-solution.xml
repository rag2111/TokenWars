<policies>
  <!--
    Token Wars - AI gateway policy (SOLUTION, TODO 3.5 complete) for the "openai" API.
    Apply with:  terraform apply -var 'apim_policy_file=policies/ai-gateway-solution.xml'

    Template variables: $${backend_id} (primary), $${pool_backend_id} (pool or primary), $${tokens_per_minute}.
  -->
  <inbound>
    <base />

    <!-- SOLUTION 3.5a: token budget per consumer (one counter per APIM subscription). Over the limit -> 429 + Retry-After. -->
    <llm-token-limit counter-key="@(context.Subscription.Id)"
                     tokens-per-minute="${tokens_per_minute}"
                     estimate-prompt-tokens="false"
                     remaining-tokens-header-name="x-ratelimit-remaining-tokens"
                     tokens-consumed-header-name="x-tokens-consumed" />

    <!-- SOLUTION 3.5b: token metrics to Application Insights (custom metrics, namespace "tokenwars"). -->
    <llm-emit-token-metric namespace="tokenwars">
      <dimension name="Subscription ID" />
      <dimension name="API ID" />
      <dimension name="Operation ID" />
      <dimension name="Model" value="@{
          var body = context.Request.Body?.As&lt;Newtonsoft.Json.Linq.JObject&gt;(preserveContent: true);
          var model = body?[&quot;model&quot;]?.ToString();
          return string.IsNullOrEmpty(model) ? &quot;unknown&quot; : model;
      }" />
    </llm-emit-token-metric>

    <!-- SOLUTION 3.5c (part 1): send traffic to the failover pool (priority 1 = primary, priority 2 = secondary). -->
    <set-backend-service backend-id="${pool_backend_id}" />

    <!-- Keyless backend auth with APIM's managed identity. -->
    <authentication-managed-identity resource="https://cognitiveservices.azure.com" />

    <!-- Never forward the caller's APIM subscription key to the model endpoint. -->
    <set-header name="api-key" exists-action="delete" />
  </inbound>

  <backend>
    <!-- SOLUTION 3.5c (part 2): retry throttled / failed calls. Each retry re-selects a backend from the pool,
         so once the primary's circuit breaker is open (3 x 429/5xx per minute) traffic flows to the secondary. -->
    <retry condition="@(context.Response.StatusCode == 429 || context.Response.StatusCode >= 500)"
           count="2" interval="1" max-interval="8" delta="2" first-fast-retry="true">
      <forward-request buffer-request-body="true" timeout="120" />
    </retry>
  </backend>

  <outbound>
    <base />
    <!-- Show which backend served the call (useful for the failover demo). -->
    <set-header name="x-tokenwars-backend" exists-action="override">
      <value>@(context.Request.Url.Host)</value>
    </set-header>
  </outbound>

  <on-error>
    <base />
  </on-error>
</policies>
